{%- props
    ## string Unique identifier for the Accordion.
    id,
    ## boolean Whether multiple items can be opened at once.
    multiple = false,
    ## 'vertical'|'horizontal' The visual orientation.
    orientation = 'vertical'
-%}

{% props
    # A regular inline comment
    label = 'Label', error = null %}

{% types {
    ## Unique identifier for the accordion.
    id: 'string',

    ## Whether several items can be open at the same time.
    multiple?: 'boolean',
} %}

{% set
    ## The page title
    title = 'Home' %}

{% set
    ## The rendered navigation
    navigation %}
    <nav></nav>
{% endset %}

{% for
    ## Current item
    item in items %}
    {{ item }}
{% endfor %}

{% for
    ## The key
    key,
    ## The value
    value in items if value is not null %}
    {{ key }}: {{ value }}
{% endfor %}

{% macro input(
    ## Field name
    name,
    ## Field value
    value = '',
    type = 'text'
) %}
    <input type="{{ type }}" name="{{ name }}" value="{{ value }}">
{% endmacro %}

<div {{ attributes.defaults({
    # The slot name used for styling
    'data-slot': 'accordion',
    # Stimulus controller
    'data-controller': 'accordion',
}) }}></div>

{{ {
    fruit: 'apple', # this is an inline comment
    color: 'red', # this is an inline comment
}|join(', ') }}

{{
    # this is an inline comment
    "Hello World"|upper
}}

{{
    "Hello World"|upper # this is an inline comment
}}

{% props
    id, # the id
    label = null # the label
%}

{% types {
    id: 'string', ## documents the next variable
    name: 'string',
} %}

{% macro button(
    label, # the label
    type = 'button' # the type
) %}
    <button type="{{ type }}">{{ label }}</button>
{% endmacro %}
